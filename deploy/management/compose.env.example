# Copy outside the repository and pass with --env-file. No value below is secret.
A2FLOW_MANAGEMENT_PROJECT_NAME=a2flow-management-prt
A2FLOW_MANAGEMENT_IMAGE=a2flow-management-private:af13
A2FLOW_MANAGEMENT_UID=1000
A2FLOW_MANAGEMENT_GID=1000
A2FLOW_MANAGEMENT_HOST_PORT=8766
A2FLOW_MANAGEMENT_BROWSER_PORT=14177
A2FLOW_MANAGEMENT_DATABASE_NAME=a2flow_management_prt
A2FLOW_MANAGEMENT_DATABASE_USER=a2flow_management
A2FLOW_MANAGEMENT_ASSET_NAMESPACE=a2flow-mvp-activity-planning
A2FLOW_MANAGEMENT_USER_ID=101
A2FLOW_MANAGEMENT_GUEST_USER_ID=102
A2FLOW_MANAGEMENT_BROWSER_ORIGIN=http://127.0.0.1:14177
A2FLOW_MANAGEMENT_STATIC_HOST_DIRECTORY=/absolute/path/to/apps/management/web/dist
A2FLOW_MANAGEMENT_SECRET_DIRECTORY=/absolute/private/path/to/a2flow-management-secrets
