# Render DOMAIN and upstream ports before enabling.
server {
    listen 80;
    server_name ${DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/a2flow-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://${DOMAIN}$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:A2FlowTLS:10m;
    ssl_session_timeout 1d;
    client_max_body_size 2m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    location ^~ /api/internal/ { return 404; }
    location /api/management/v2/ { include /etc/nginx/a2flow-proxy-headers.conf; proxy_pass http://127.0.0.1:8790; }
    location /api/ { include /etc/nginx/a2flow-proxy-headers.conf; proxy_pass http://127.0.0.1:8785; }
    location /employee/ { include /etc/nginx/a2flow-proxy-headers.conf; proxy_pass http://127.0.0.1:8785; }
    location / { include /etc/nginx/a2flow-proxy-headers.conf; proxy_pass http://127.0.0.1:8790; }
}
