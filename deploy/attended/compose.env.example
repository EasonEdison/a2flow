# Attended deployment env (no secrets here). Copy outside the repository.
A2FLOW_ATTENDED_PROJECT_NAME=a2flow-attended
A2FLOW_ATTENDED_IMAGE=a2flow-attended:af13
A2FLOW_ATTENDED_UID=1000
A2FLOW_ATTENDED_GID=1000
A2FLOW_ATTENDED_SECRET_DIRECTORY=/absolute/private/a2flow-attended-secrets
# shared database
A2FLOW_ATTENDED_DB_USER=a2flow_attended
A2FLOW_ATTENDED_DB_NAME=a2flow_attended
# asset / runtime
A2FLOW_ENVIRONMENT=PRT
A2FLOW_ASSET_NAMESPACE=a2flow-mvp-activity-planning
A2FLOW_USER_ID=101
# b-side
A2FLOW_BSIDE_VALIDATOR_FACTORY=activity_planning_demo:bundle_validator
A2FLOW_BSIDE_PEPPER=change-me-owner-only
A2FLOW_BSIDE_BROWSER_ORIGIN=http://127.0.0.1:14180
A2FLOW_BSIDE_SESSION_SECONDS=7200
# scheduler
A2FLOW_SCHEDULER_TRIGGER_SECONDS=30
A2FLOW_SCHEDULER_MONITOR_SECONDS=300
A2FLOW_WAIT_TIMEOUT_HOURS=24
# Private env additions (never commit): A2FLOW_ATTENDED_DEEPSEEK_KEY
# Feishu (owner-only; optional in v1 e2e stub)
A2FLOW_LARK_WEBHOOK_URL=
A2FLOW_LARK_SECRET=
