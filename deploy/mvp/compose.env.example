# Copy this file outside the repository and pass it with --env-file.
A2FLOW_PROJECT_NAME=a2flow-private
A2FLOW_HOST_PORT=8765
A2FLOW_DATABASE_NAME=a2flow
A2FLOW_DATABASE_USER=a2flow
A2FLOW_ENVIRONMENT=PRT
A2FLOW_USER_ID=101
A2FLOW_ASSET_NAMESPACE=a2flow-mvp-activity-planning
A2FLOW_DEMO=activity-package
A2FLOW_STATIC_HOST_DIRECTORY=/absolute/path/to/apps/digital-employee/web/dist
A2FLOW_SECRET_DIRECTORY=/absolute/private/path/to/a2flow-secrets
A2FLOW_MODEL_CALL_LIMIT=27
A2FLOW_MODEL_MAX_TOKENS=2048
A2FLOW_MODEL_TIMEOUT_SECONDS=20
