{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "https://schemas.skillweave.example/contracts/SW-CONTRACTS-P1-CANDIDATE.1/contracts-bundle.schema.json",
  "title": "SkillWeave Phase 1 shared contract candidate",
  "description": "Provisional transport-neutral contract shapes. Main-brain review is required before dependent implementation.",
  "definitions": {
    "contractRevision": {
      "enum": [
        "SW-CONTRACTS-P1-CANDIDATE.1"
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[\\r\\n])[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "trustedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "environment"
      ],
      "properties": {
        "userId": {
          "$ref": "#/definitions/longUserId"
        },
        "environment": {
          "enum": [
            "PRT",
            "ONLINE"
          ]
        }
      }
    },
    "trustedPrtContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "environment"
      ],
      "properties": {
        "userId": {
          "$ref": "#/definitions/longUserId"
        },
        "environment": {
          "enum": [
            "PRT"
          ]
        }
      }
    },
    "trustedOnlineContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "environment"
      ],
      "properties": {
        "userId": {
          "$ref": "#/definitions/longUserId"
        },
        "environment": {
          "enum": [
            "ONLINE"
          ]
        }
      }
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetType",
        "assetId"
      ],
      "properties": {
        "assetType": {
          "enum": [
            "SKILL",
            "ABILITY",
            "COMPONENT",
            "APPLICATION",
            "WORKFLOW"
          ]
        },
        "assetId": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "assetVersionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "versionId"
      ],
      "properties": {
        "asset": {
          "$ref": "#/definitions/assetRef"
        },
        "versionId": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "assetServingState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractRevision",
            "asset",
            "environment",
            "currentVersionId",
            "servingRevision"
          ],
          "properties": {
            "contractRevision": {
              "$ref": "#/definitions/contractRevision"
            },
            "asset": {
              "$ref": "#/definitions/assetRef"
            },
            "environment": {
              "enum": [
                "PRT"
              ]
            },
            "currentVersionId": {
              "$ref": "#/definitions/identifier"
            },
            "servingRevision": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractRevision",
            "asset",
            "environment",
            "stableVersionId",
            "servingRevision"
          ],
          "properties": {
            "contractRevision": {
              "$ref": "#/definitions/contractRevision"
            },
            "asset": {
              "$ref": "#/definitions/assetRef"
            },
            "environment": {
              "enum": [
                "ONLINE"
              ]
            },
            "stableVersionId": {
              "$ref": "#/definitions/identifier"
            },
            "candidateVersionId": {
              "$ref": "#/definitions/identifier"
            },
            "servingRevision": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "assetResolution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractRevision",
            "trustedContext",
            "asset",
            "selection",
            "effectiveVersion"
          ],
          "properties": {
            "contractRevision": {
              "$ref": "#/definitions/contractRevision"
            },
            "trustedContext": {
              "$ref": "#/definitions/trustedPrtContext"
            },
            "asset": {
              "$ref": "#/definitions/assetRef"
            },
            "selection": {
              "enum": [
                "PRT_CURRENT"
              ]
            },
            "effectiveVersion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "versionId",
                "sourceEnvironment"
              ],
              "properties": {
                "versionId": {
                  "$ref": "#/definitions/identifier"
                },
                "sourceEnvironment": {
                  "enum": [
                    "PRT"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractRevision",
            "trustedContext",
            "asset",
            "selection",
            "effectiveVersion"
          ],
          "properties": {
            "contractRevision": {
              "$ref": "#/definitions/contractRevision"
            },
            "trustedContext": {
              "$ref": "#/definitions/trustedOnlineContext"
            },
            "asset": {
              "$ref": "#/definitions/assetRef"
            },
            "selection": {
              "enum": [
                "ONLINE_STABLE"
              ]
            },
            "effectiveVersion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "versionId",
                "sourceEnvironment"
              ],
              "properties": {
                "versionId": {
                  "$ref": "#/definitions/identifier"
                },
                "sourceEnvironment": {
                  "enum": [
                    "ONLINE"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractRevision",
            "trustedContext",
            "asset",
            "selection",
            "effectiveVersion"
          ],
          "properties": {
            "contractRevision": {
              "$ref": "#/definitions/contractRevision"
            },
            "trustedContext": {
              "$ref": "#/definitions/trustedOnlineContext"
            },
            "asset": {
              "$ref": "#/definitions/assetRef"
            },
            "selection": {
              "enum": [
                "ONLINE_GRAY"
              ]
            },
            "effectiveVersion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "versionId",
                "sourceEnvironment"
              ],
              "properties": {
                "versionId": {
                  "$ref": "#/definitions/identifier"
                },
                "sourceEnvironment": {
                  "enum": [
                    "ONLINE"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "versionMismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "recordedVersionId"
      ],
      "properties": {
        "asset": {
          "$ref": "#/definitions/assetRef"
        },
        "recordedVersionId": {
          "$ref": "#/definitions/identifier"
        },
        "effectiveVersionId": {
          "$ref": "#/definitions/identifier"
        },
        "resolutionFailureCode": {
          "$ref": "#/definitions/identifier"
        }
      },
      "oneOf": [
        {
          "required": [
            "effectiveVersionId"
          ]
        },
        {
          "required": [
            "resolutionFailureCode"
          ]
        }
      ]
    },
    "versionGuardDecision": {
      "oneOf": [
        {
          "$ref": "#/definitions/allowVersionGuardDecision"
        },
        {
          "$ref": "#/definitions/resetVersionGuardDecision"
        }
      ]
    },
    "controlRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractRevision",
        "controlRequestId",
        "commandType",
        "trustedContext",
        "target",
        "payloadDigest"
      ],
      "properties": {
        "contractRevision": {
          "$ref": "#/definitions/contractRevision"
        },
        "controlRequestId": {
          "$ref": "#/definitions/identifier"
        },
        "commandType": {
          "enum": [
            "START_RUN",
            "CONTINUE_RUN",
            "SUBMIT_NODE_INPUT",
            "SUBMIT_INTERACTION",
            "RETRY_A2UI_NODE",
            "STOP_RUN"
          ]
        },
        "trustedContext": {
          "$ref": "#/definitions/trustedContext"
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/definitions/startTarget"
            },
            {
              "$ref": "#/definitions/runTarget"
            },
            {
              "$ref": "#/definitions/nodeTarget"
            },
            {
              "$ref": "#/definitions/interactionTarget"
            }
          ]
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])sha256:[0-9a-f]{64}$"
        },
        "recordedAssetVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/assetVersionRef"
          }
        },
        "retryReason": {
          "enum": [
            "RENDER_FAILED",
            "ACTION_CALL_FAILED",
            "ACTION_RESULT_NOT_SUCCESS"
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "commandType": {
                  "enum": [
                    "START_RUN"
                  ]
                },
                "target": {
                  "$ref": "#/definitions/startTarget"
                }
              },
              "required": [
                "commandType",
                "target"
              ],
              "not": {
                "required": [
                  "retryReason"
                ]
              }
            },
            {
              "properties": {
                "commandType": {
                  "enum": [
                    "CONTINUE_RUN"
                  ]
                },
                "target": {
                  "$ref": "#/definitions/runTarget"
                }
              },
              "required": [
                "commandType",
                "target",
                "recordedAssetVersions"
              ],
              "not": {
                "required": [
                  "retryReason"
                ]
              }
            },
            {
              "properties": {
                "commandType": {
                  "enum": [
                    "STOP_RUN"
                  ]
                },
                "target": {
                  "$ref": "#/definitions/runTarget"
                }
              },
              "required": [
                "commandType",
                "target"
              ],
              "not": {
                "required": [
                  "retryReason"
                ]
              }
            },
            {
              "properties": {
                "commandType": {
                  "enum": [
                    "SUBMIT_NODE_INPUT"
                  ]
                },
                "target": {
                  "$ref": "#/definitions/nodeTarget"
                }
              },
              "required": [
                "commandType",
                "target",
                "recordedAssetVersions"
              ],
              "not": {
                "required": [
                  "retryReason"
                ]
              }
            },
            {
              "properties": {
                "commandType": {
                  "enum": [
                    "RETRY_A2UI_NODE"
                  ]
                },
                "target": {
                  "$ref": "#/definitions/nodeTarget"
                },
                "retryReason": {
                  "enum": [
                    "RENDER_FAILED",
                    "ACTION_CALL_FAILED",
                    "ACTION_RESULT_NOT_SUCCESS"
                  ]
                }
              },
              "required": [
                "commandType",
                "target",
                "recordedAssetVersions",
                "retryReason"
              ]
            },
            {
              "properties": {
                "commandType": {
                  "enum": [
                    "SUBMIT_INTERACTION"
                  ]
                },
                "target": {
                  "$ref": "#/definitions/interactionTarget"
                }
              },
              "required": [
                "commandType",
                "target",
                "recordedAssetVersions"
              ],
              "not": {
                "required": [
                  "retryReason"
                ]
              }
            }
          ]
        }
      ]
    },
    "startTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowVersion"
      ],
      "properties": {
        "workflowVersion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset",
            "versionId"
          ],
          "properties": {
            "asset": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetType",
                "assetId"
              ],
              "properties": {
                "assetType": {
                  "enum": [
                    "WORKFLOW"
                  ]
                },
                "assetId": {
                  "$ref": "#/definitions/identifier"
                }
              }
            },
            "versionId": {
              "$ref": "#/definitions/identifier"
            }
          }
        }
      }
    },
    "runTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "nodeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "nodeId"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/identifier"
        },
        "nodeId": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "interactionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "nodeId",
        "interactionId",
        "surfaceId",
        "sourceComponentId"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/identifier"
        },
        "nodeId": {
          "$ref": "#/definitions/identifier"
        },
        "interactionId": {
          "$ref": "#/definitions/identifier"
        },
        "surfaceId": {
          "$ref": "#/definitions/identifier"
        },
        "sourceComponentId": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "resultInterpretationPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractRevision",
            "policyRef",
            "operator"
          ],
          "properties": {
            "contractRevision": {
              "$ref": "#/definitions/contractRevision"
            },
            "policyRef": {
              "$ref": "#/definitions/identifier"
            },
            "operator": {
              "enum": [
                "SCHEMA_VALID"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractRevision",
            "policyRef",
            "operator",
            "jsonPointer",
            "expectedLiteral"
          ],
          "properties": {
            "contractRevision": {
              "$ref": "#/definitions/contractRevision"
            },
            "policyRef": {
              "$ref": "#/definitions/identifier"
            },
            "operator": {
              "enum": [
                "JSON_POINTER_EQUALS"
              ]
            },
            "jsonPointer": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$"
            },
            "expectedLiteral": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        }
      ]
    },
    "resultInterpretationPolicySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultInterpretationPolicies",
        "defaultSuccessPolicyRef"
      ],
      "properties": {
        "resultInterpretationPolicies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/resultInterpretationPolicy"
          }
        },
        "defaultSuccessPolicyRef": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "actionSuccessPolicyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successPolicyRef",
        "completeInteractionOnSuccess"
      ],
      "properties": {
        "successPolicyRef": {
          "$ref": "#/definitions/identifier"
        },
        "completeInteractionOnSuccess": {
          "type": "boolean"
        }
      }
    },
    "actionOutcomeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionCallSucceeded",
        "outputSchemaValid",
        "successPolicyMatched",
        "interactionCompleted"
      ],
      "properties": {
        "actionCallSucceeded": {
          "type": "boolean"
        },
        "outputSchemaValid": {
          "type": "boolean"
        },
        "successPolicyMatched": {
          "type": "boolean"
        },
        "interactionCompleted": {
          "type": "boolean"
        }
      }
    },
    "runRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "nodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "nodeId"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/identifier"
        },
        "nodeId": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "interactionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "nodeId",
        "interactionId"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/identifier"
        },
        "nodeId": {
          "$ref": "#/definitions/identifier"
        },
        "interactionId": {
          "$ref": "#/definitions/identifier"
        }
      }
    },
    "interactionResultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "nodeId",
        "interactionId",
        "resultId",
        "scope"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/identifier"
        },
        "nodeId": {
          "$ref": "#/definitions/identifier"
        },
        "interactionId": {
          "$ref": "#/definitions/identifier"
        },
        "resultId": {
          "$ref": "#/definitions/identifier"
        },
        "scope": {
          "enum": [
            "INTERACTION"
          ]
        }
      }
    },
    "nodeResultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "nodeId",
        "resultId",
        "scope"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/identifier"
        },
        "nodeId": {
          "$ref": "#/definitions/identifier"
        },
        "resultId": {
          "$ref": "#/definitions/identifier"
        },
        "scope": {
          "enum": [
            "NODE"
          ]
        }
      }
    },
    "runResultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "resultId",
        "scope"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/identifier"
        },
        "resultId": {
          "$ref": "#/definitions/identifier"
        },
        "scope": {
          "enum": [
            "RUN"
          ]
        }
      }
    },
    "resultRef": {
      "oneOf": [
        {
          "$ref": "#/definitions/interactionResultRef"
        },
        {
          "$ref": "#/definitions/nodeResultRef"
        },
        {
          "$ref": "#/definitions/runResultRef"
        }
      ]
    },
    "executionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractRevision",
        "eventId",
        "runSequence",
        "eventType",
        "occurredAt",
        "trustedContext"
      ],
      "properties": {
        "contractRevision": {
          "$ref": "#/definitions/contractRevision"
        },
        "eventId": {
          "$ref": "#/definitions/identifier"
        },
        "runSequence": {
          "type": "integer",
          "minimum": 1
        },
        "eventType": {
          "enum": [
            "RUN_ACCEPTED",
            "RUN_STOPPED",
            "NODE_STATUS_CHANGED",
            "INTERACTION_WAITING",
            "INTERACTION_RESULT_RECORDED",
            "NODE_RESULT_RECORDED",
            "RUN_RESULT_RECORDED",
            "VERSION_MISMATCH_BLOCKED"
          ]
        },
        "occurredAt": {
          "type": "string",
          "minLength": 1
        },
        "trustedContext": {
          "$ref": "#/definitions/trustedContext"
        },
        "runRef": {
          "$ref": "#/definitions/runRef"
        },
        "nodeRef": {
          "$ref": "#/definitions/nodeRef"
        },
        "interactionRef": {
          "$ref": "#/definitions/interactionRef"
        },
        "resultRef": {
          "$ref": "#/definitions/resultRef"
        },
        "nodeStatus": {
          "enum": [
            "PENDING",
            "RUNNING",
            "WAITING_INTERACTION",
            "SUCCEEDED",
            "FAILED",
            "SKIPPED",
            "STOPPED"
          ]
        },
        "versionGuardDecision": {
          "$ref": "#/definitions/versionGuardDecision"
        },
        "causationControlRequestId": {
          "$ref": "#/definitions/identifier"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "eventType": {
                  "enum": [
                    "RUN_ACCEPTED",
                    "RUN_STOPPED"
                  ]
                }
              },
              "required": [
                "eventType",
                "runRef"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "nodeRef"
                    ]
                  },
                  {
                    "required": [
                      "interactionRef"
                    ]
                  },
                  {
                    "required": [
                      "resultRef"
                    ]
                  },
                  {
                    "required": [
                      "nodeStatus"
                    ]
                  },
                  {
                    "required": [
                      "versionGuardDecision"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "eventType": {
                  "enum": [
                    "NODE_STATUS_CHANGED"
                  ]
                },
                "nodeRef": {
                  "$ref": "#/definitions/nodeRef"
                }
              },
              "required": [
                "eventType",
                "nodeRef",
                "nodeStatus"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "runRef"
                    ]
                  },
                  {
                    "required": [
                      "interactionRef"
                    ]
                  },
                  {
                    "required": [
                      "resultRef"
                    ]
                  },
                  {
                    "required": [
                      "versionGuardDecision"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "eventType": {
                  "enum": [
                    "INTERACTION_WAITING"
                  ]
                },
                "interactionRef": {
                  "$ref": "#/definitions/interactionRef"
                }
              },
              "required": [
                "eventType",
                "interactionRef"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "runRef"
                    ]
                  },
                  {
                    "required": [
                      "nodeRef"
                    ]
                  },
                  {
                    "required": [
                      "resultRef"
                    ]
                  },
                  {
                    "required": [
                      "nodeStatus"
                    ]
                  },
                  {
                    "required": [
                      "versionGuardDecision"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "eventType": {
                  "enum": [
