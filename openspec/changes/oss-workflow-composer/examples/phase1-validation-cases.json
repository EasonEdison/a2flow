{
  "_meta": {
    "status": "PROVISIONAL_CONSUMER_REQUIREMENT",
    "baseline": "SW-P1-20260907.2",
    "productValidatorEvidence": false
  },
  "staticCases": [
    {"caseId": "cycle", "mutation": "add end->start", "expectedIssues": ["GRAPH_CYCLE"]},
    {"caseId": "unknown-candidate-target", "mutation": "route fast to missing node", "expectedIssues": ["DECISION_TARGET_UNKNOWN"]},
    {"caseId": "parallel-branch-mismatch", "mutation": "remove branch B exit from join", "expectedIssues": ["PARALLEL_BRANCH_MISMATCH"]},
    {"caseId": "nested-parallel", "mutation": "add split inside branch A", "expectedIssues": ["PARALLEL_NESTING_NOT_SUPPORTED"]},
    {"caseId": "unreachable-node", "mutation": "add disconnected skill", "expectedIssues": ["GRAPH_UNREACHABLE"]}
  ],
  "runtimeCases": [
    {
      "caseId": "a-waits-b-continues",
      "given": ["A=WAITING_INTERACTION", "B1=SUCCESS"],
      "expected": ["B2=SUCCESS", "JOIN=WAITING"]
    },
    {
      "caseId": "allow-skip-failure-can-join",
      "given": ["A=SUCCESS", "B2=FAILED_ALLOW_SKIP"],
      "expected": ["B_STATUS=FAILED", "JOIN=READY"]
    },
    {
      "caseId": "required-failure-blocks",
      "given": ["A_REQUIRED=FAILED", "B=SUCCESS"],
      "expected": ["JOIN=BLOCKED", "FINALIZER=NOT_ADMITTED"]
    },
    {
      "caseId": "a2ui-owning-node-retry",
      "given": ["A2UI_ACTION_SUCCESS_CONDITION=FALSE", "B=SUCCESS"],
      "expected": ["DECISION_A=RETRY_ELIGIBLE", "B=UNCHANGED"]
    },
    {
      "caseId": "accepted-stop-blocks-finalizer",
      "given": ["RUN=STOPPED"],
      "expected": ["NEW_WORK=DENIED", "FINALIZER=NOT_ADMITTED"]
    }
  ],
  "contextCases": [
    {
      "caseId": "transitive-sequence-context",
      "topology": ["skill_a", "skill_b", "skill_c"],
      "executedAncestorNodes": [
        {"nodeKey": "skill_a", "status": "SUCCESS", "finalResultRef": "result:skill-a"},
        {"nodeKey": "skill_b", "status": "SUCCESS", "finalResultRef": "result:skill-b"}
      ],
      "consumerNodeKey": "skill_c",
      "expectedContextNodeKeys": ["skill_a", "skill_b"]
    },
    {
      "caseId": "join-executed-branches-context",
      "selectedCandidateKey": "fast",
      "executedAncestorNodes": [
        {"nodeKey": "decision_a", "status": "SUCCESS", "finalResultRef": "result:decision-a"},
        {"nodeKey": "a_fast", "status": "SUCCESS", "finalResultRef": "result:a-fast"},
        {"nodeKey": "merge_a", "status": "SUCCESS", "finalResultRef": "result:merge-a"},
        {"nodeKey": "b1", "status": "SUCCESS", "finalResultRef": "result:b1"},
        {"nodeKey": "b2", "status": "FAILED", "finalResultRef": "result:b2"},
        {"nodeKey": "join", "status": "SUCCESS", "finalResultRef": "result:join"}
      ],
      "unselectedCandidateNodeKeys": ["a_review"],
      "consumerNodeKey": "finalizer",
      "expectedContextNodeKeys": [
        "decision_a",
        "a_fast",
        "merge_a",
        "b1",
        "b2",
        "join"
      ],
      "expectedAbsentNodeKeys": ["a_review"]
    }
  ]
}
